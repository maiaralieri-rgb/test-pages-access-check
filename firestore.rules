rules_version = '2';

// A ordem das assinaturas, o vínculo de função, a manifestação de vontade e a
// versão do documento são validados dentro de uma transação na Cloud Function.
// Essas regras existem para garantir que ninguém contorne essa validação
// escrevendo direto no banco: TODA escrita é negada ao cliente.
//
// A Cloud Function usa o Admin SDK, que passa por cima destas regras — é assim
// que ela continua podendo gravar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoordinator() {
      return signedIn() && request.auth.token.role == 'coordinator';
    }

    // Processos: leitura para quem está autenticado; escrita somente pela função.
    match /processes/{processId} {
      allow read: if signedIn();
      allow write: if false;

      // Evidência de assinatura é imutável para o cliente.
      match /signatures/{stageKey} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Perfil: cada conta lê o próprio; a coordenação lê todos. Ninguém escreve
    // pelo cliente, senão seria possível se promover a coordenador.
    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCoordinator());
      allow write: if false;
    }

    // Vínculo de função: leitura para o próprio titular e para a coordenação.
    match /members/{memberId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Convites guardam o hash do token; nunca são expostos ao cliente.
    match /invites/{tokenHash} {
      allow read, write: if false;
    }

    // Qualquer coleção não prevista fica fechada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
