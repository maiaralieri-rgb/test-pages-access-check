# Copie para .env e preencha no ambiente de destino.
# Nunca versione os valores reais nem os envie em pacotes de transferência.
# `pnpm env:setup` gera os segredos locais automaticamente.

# ---------------------------------------------------------------------------
# Obrigatório em qualquer modo
# ---------------------------------------------------------------------------

# Segredo do cadastro por convite. Fica somente no servidor; se estiver vazio,
# nenhum cadastro é aceito (o sistema falha fechado).
ASSINAFLUXO_REGISTRATION_CODE=

# Assinatura de cookies de sessão (usado apenas no modo de contas locais).
JWT_SECRET=

# ---------------------------------------------------------------------------
# Modo Firebase (recomendado — é o que dá o link público)
# ---------------------------------------------------------------------------
# Definir FIREBASE_PROJECT_ID já ativa Firestore + Firebase Auth no servidor.

FIREBASE_PROJECT_ID=
# Fora do Cloud Functions/Cloud Run, informe a service account em JSON:
FIREBASE_SERVICE_ACCOUNT=

# Config pública do cliente (aparece no navegador por design; quem autoriza é o
# Firebase Auth junto das Security Rules, que negam toda escrita do cliente).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Emuladores locais (deixe vazio em produção):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099

# ---------------------------------------------------------------------------
# Modo MySQL (alternativa ao Firebase)
# ---------------------------------------------------------------------------
# Sem Firebase e sem DATABASE_URL, o app roda com armazenamento local em
# .data/assinafluxo.json (processo único, apenas para desenvolvimento).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Portas (opcional)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_PORT=3000
# EXPO_PUBLIC_WEB_PORT=8081
# EXPO_PUBLIC_API_BASE_URL=
